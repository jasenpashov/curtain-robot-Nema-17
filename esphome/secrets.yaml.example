# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is listed in .gitignore and must never be committed.

wifi_ssid: "YourNetwork"
wifi_password: "YourPassword"

# Generate a fresh key for each device:
#   openssl rand -base64 32
api_key_left:  "REPLACE_WITH_YOUR_OWN_32_BYTE_BASE64_KEY="
api_key_right: "REPLACE_WITH_YOUR_OWN_32_BYTE_BASE64_KEY="
